{
  "name": "theme-designer",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "build-prod": "ng build --configuration production --base-href /PrimeNG_Theme_Designer/",
    "storybook": "ng run theme-designer:storybook",
    "storybookno": "NODE_OPTIONS='--no-deprecation' ng run theme-designer:storybook dev -p 6006",
    "build-storybook": "ng run theme-designer:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@primeuix/themes": "3.0.0-rc.1",
    "primeicons": "^7.0.0",
    "primeng": "22.0.0-rc.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@angular-devkit/architect": "^0.2200.0",
    "@angular-devkit/build-angular": "^22.0.5",
    "@angular-devkit/core": "^22.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@ngx-env/builder": "^21.0.1",
    "@storybook/angular-vite": "^10.5.4",
    "@types/node": "^20",
    "angular-mcp-server": "^1.1.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "storybook": "^10.5.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.8"
  }
}